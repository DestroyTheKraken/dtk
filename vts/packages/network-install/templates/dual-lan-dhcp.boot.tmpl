# Valley Tech client router — dual LAN + DHCP defaults
# Placeholders replaced by interactive-provision.sh:
#   __HOSTNAME__  __WAN_IF__  __LAN1_IF__  __LAN2_IF__
#   __LAN1_SUBNET__ __LAN1_GW__ __LAN1_DHCP_START__ __LAN1_DHCP_STOP__
#   __LAN2_SUBNET__ __LAN2_GW__ __LAN2_DHCP_START__ __LAN2_DHCP_STOP__
#
# Defaults when not overridden:
#   LAN1 Trusted  192.168.10.0/24  gw 192.168.10.1  pool .100-.200
#   LAN2 GuestIoT 192.168.50.0/24  gw 192.168.50.1  pool .100-.200
#   WAN DHCP client
#
# Apply on VyOS:
#   configure
#   load /config/valley-tech/dual-lan-dhcp.boot   # or paste set commands
#   commit ; save

# --- System ---
set system host-name '__HOSTNAME__'
set system name-server '1.1.1.1'
set system name-server '1.0.0.1'
set system time-zone 'America/Los_Angeles'

# --- Interfaces ---
set interfaces ethernet __WAN_IF__ address dhcp
set interfaces ethernet __WAN_IF__ description 'WAN-ISP'
set interfaces ethernet __LAN1_IF__ address '__LAN1_GW__/24'
set interfaces ethernet __LAN1_IF__ description 'LAN1-Trusted'
set interfaces ethernet __LAN2_IF__ address '__LAN2_GW__/24'
set interfaces ethernet __LAN2_IF__ description 'LAN2-Guest-IoT'

# --- NAT (both LANs out WAN) ---
set nat source rule 100 description 'LAN1-to-WAN'
set nat source rule 100 outbound-interface name '__WAN_IF__'
set nat source rule 100 source address '__LAN1_SUBNET__'
set nat source rule 100 translation address masquerade
set nat source rule 110 description 'LAN2-to-WAN'
set nat source rule 110 outbound-interface name '__WAN_IF__'
set nat source rule 110 source address '__LAN2_SUBNET__'
set nat source rule 110 translation address masquerade

# --- DHCP LAN1 Trusted ---
set service dhcp-server shared-network-name TRUSTED authoritative
set service dhcp-server shared-network-name TRUSTED subnet __LAN1_SUBNET__ subnet-id 1
set service dhcp-server shared-network-name TRUSTED subnet __LAN1_SUBNET__ default-router '__LAN1_GW__'
set service dhcp-server shared-network-name TRUSTED subnet __LAN1_SUBNET__ name-server '1.1.1.1'
set service dhcp-server shared-network-name TRUSTED subnet __LAN1_SUBNET__ name-server '1.0.0.1'
set service dhcp-server shared-network-name TRUSTED subnet __LAN1_SUBNET__ lease '86400'
set service dhcp-server shared-network-name TRUSTED subnet __LAN1_SUBNET__ range 0 start '__LAN1_DHCP_START__'
set service dhcp-server shared-network-name TRUSTED subnet __LAN1_SUBNET__ range 0 stop '__LAN1_DHCP_STOP__'

# --- DHCP LAN2 Guest / IoT ---
set service dhcp-server shared-network-name GUESTIOT authoritative
set service dhcp-server shared-network-name GUESTIOT subnet __LAN2_SUBNET__ subnet-id 2
set service dhcp-server shared-network-name GUESTIOT subnet __LAN2_SUBNET__ default-router '__LAN2_GW__'
set service dhcp-server shared-network-name GUESTIOT subnet __LAN2_SUBNET__ name-server '1.1.1.1'
set service dhcp-server shared-network-name GUESTIOT subnet __LAN2_SUBNET__ name-server '1.0.0.1'
set service dhcp-server shared-network-name GUESTIOT subnet __LAN2_SUBNET__ lease '86400'
set service dhcp-server shared-network-name GUESTIOT subnet __LAN2_SUBNET__ range 0 start '__LAN2_DHCP_START__'
set service dhcp-server shared-network-name GUESTIOT subnet __LAN2_SUBNET__ range 0 stop '__LAN2_DHCP_STOP__'

# --- Firewall: zone-style isolation (nftables path varies by VyOS version;
#     use these as intent; interactive provisioner may adapt syntax after dry-run) ---
# Policy summary (implement with firewall ipv4 in apply script if set lines differ):
#   WAN local: allow established, DHCP, limited SSH if desired
#   LAN2 → LAN1: drop
#   LAN1 → LAN2: drop
#   LAN1/LAN2 → WAN: accept
# See provision/firewall-dual-lan.md for version-specific commands.

set service ssh port '22'
set service ssh listen-address '__LAN1_GW__'
